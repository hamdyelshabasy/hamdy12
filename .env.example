# ==============================================================================
# منصة الفيزياء الاحترافية — ملف إعدادات البيئة النموذجي (.env.example)
# ==============================================================================

# --- Cloud SQL (PostgreSQL) — يتم حقنها تلقائيًا في بيئة التشغيل ---
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# --- مفاتيح الأمان والتشفير الإلزامية في الإنتاج (يجب أن يكون كل مفتاح مستقلًا وعشوائيًا لا يقل عن 32 حرفًا) ---
# مفتاح توقيع روابط تشغيل الفيديو المؤقتة (إلزامي في الإنتاج)
VIDEO_SIGNING_SECRET=
# مفتاح توقيع روابط معاينة وتحميل ملفات الواجبات المستقرة عبر إعادة التشغيل (إلزامي في الإنتاج)
HOMEWORK_FILE_SIGNING_SECRET=
# مفتاح فلفل (Pepper) لتجزئة أكواد التفعيل قبل تخزينها في قاعدة البيانات (إلزامي في الإنتاج — لا تغيّره بعد توزيع أكواد إلا بخطة تدوير)
CODE_PEPPER=
# اختياري فقط أثناء فترة انتقالية لتدوير CODE_PEPPER مع الحفاظ على صلاحية الأكواد القديمة غير المستخدمة
CODE_PEPPER_PREVIOUS=
# اختياري / متوافق قديمًا فقط في بيئة التطوير (جلسات الدخول تعتمد على قاعدة البيانات ولا تستخدمه في الإنتاج)
SESSION_SECRET=
# النطاقات المسموح لها بالوصول عبر CORS في الإنتاج (مفصولة بفاصلة، مثال: https://app.example.com)
ALLOWED_ORIGINS=

# --- إعدادات بوابات الدفع في مصر (اختياري للتفعيل الإنتاجي) ---
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
FAWRY_MERCHANT_CODE=
FAWRY_SECURITY_KEY=

# --- إعدادات بث الفيديو الآمن و DRM (اختياري للربط الإنتاجي) ---
VIDEO_STREAM_PROVIDER=internal_signed
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# --- الإشعارات والرسائل (اختياري) ---
SMS_OTP_PROVIDER=disabled
SMS_API_KEY=
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- بيانات تهيئة حساب المدير الأساسي عند الإطلاق الأول (لا تُخزّن في الكود) ---
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PHONE=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
ENABLE_DEMO_ACCOUNTS=true
